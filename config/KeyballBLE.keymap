define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10
#include "dts/mouse-gesture.local.dtsi"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&msc {
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/* ===============================
 * mouse-gesture の hold-tap 必須設定（ビルド落ち対策）
 * =============================== */

&mouse_gesture_kp {
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
    flavor = "tap-preferred";
};

&mouse_gesture_mkp {
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        mb2_combo {
            bindings = <&mkp MB2>;
            key-positions = <19 18>;
        };

        scroll_combos {
            bindings = <&tog 5>;
            key-positions = <7 8>;
        };

        ps_photo_toggle {
            bindings = <&tog 8>;
            key-positions = <13 14>; /* F + G */
        };

        drag_off_combo {
            bindings = <&drag_off>;
            key-positions = <20 19>;
        };

        key1 {
            bindings = <&kp EXCLAMATION>;
            key-positions = <17 18>;
        };

        key2 {
            bindings = <&kp QUESTION>;
            key-positions = <29 30>;
        };

        scrl_up {
            bindings = <&msc MOVE_UP>;
            key-positions = <20 21>;
        };

        scrl_down {
            bindings = <&msc MOVE_DOWN>;
            key-positions = <32 33>;
        };

        left_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <0 1>;
        };

        right_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <8 9>;
        };
    };

    macros {
        safari_reload_once: safari_reload_once {
            compatible = "zmk,behavior-macro";
            label = "SAFARI_RELOAD_ONCE";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp R>,
                <&macro_release>,
                <&kp LGUI>;
        };

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        drag_on: drag_on {
            compatible = "zmk,behavior-macro";
            label = "DRAG_ON";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&mkp MB1>;
        };

        drag_off: drag_off {
            compatible = "zmk,behavior-macro";
            label = "DRAG_OFF";
            #binding-cells = <0>;
            bindings = <&macro_release>, <&mkp MB1>;
        };

        /* ★追加：&lm <layer> <mod>（押してる間だけ layer(&mo) + mod(Shiftなど) を同時ホールド） */

        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };

        vol_max: vol_max {
            compatible = "zmk,behavior-macro";
            label = "VOL_MAX";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>,
                <&macro_tap>,
                <&kp C_VOLUME_UP>;
        };

        bri_min: bri_min {
            compatible = "zmk,behavior-macro";
            label = "BRI_MIN";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>,
                <&macro_tap>,
                <&kp C_BRI_DN>;
        };

        bri_max: bri_max {
            compatible = "zmk,behavior-macro";
            label = "BRI_MAX";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>,
                <&macro_tap>,
                <&kp C_BRI_UP>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <26>;
            quick-tap-ms = <90>;
        };

        rotate: rotate {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ROTATE";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_UP>, <&msc MOVE_DOWN>;

            tap-ms = <20>;
        };

        lt_mkp: lt_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_MKP";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mod_mkp: mod_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_MKP";
            bindings = <&kp>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        dragkey: dragkey {
            compatible = "zmk,behavior-hold-tap";
            label = "DRAGKEY";
            bindings = <&drag_on>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            quick-tap-ms = <100>;
        };

        /* ===============================
         * ★追加：Tap-Dance（同じキー位置のまま）
         *  1回 = 従来の &lt
         *  2回 = Shift付きジェスチャ（&lm LSHFT）
         * =============================== */

        td_lt_a: td_lt_a {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt 1 A>, <&lm 1  LSHFT>;
        };

        td_lt_s: td_lt_s {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt 13 S>, <&lm 13 LSHFT>;
        };

        td_lt_d: td_lt_d {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt 2 D>, <&lm 2  LSHFT>;
        };

        td_lt_w: td_lt_w {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt 3 W>, <&lm 3  LSHFT>;
        };

        td_lt_e: td_lt_e {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt 11 E>, <&lm 11 LSHFT>;
        };

        td_lt_r: td_lt_r {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt 12 R>, <&lm 12 LSHFT>;
        };

        td_lt_t: td_lt_t {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt 7 T>, <&lm 7  LSHFT>;
        };

        td_lt_m: td_lt_m {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt 14 M>, <&lm 14 LSHFT>;
        };

        /* ===============================
         * ★追加：mouse-gesture 分岐枠（Shift有無で2系統）
         *  - いまは Shift側も同じにして「動作不変」
         *  - 後で bindings の2個目だけ差し替える
         * =============================== */

        mm_l1_up: mm_l1_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LC(B)>, <&kp LC(B)>;
        };

        mm_l1_down: mm_l1_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(SPACE)>, <&kp LG(SPACE)>;
        };

        mm_l1_left: mm_l1_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(LS(TAB))>, <&kp LG(Q)>;
        };

        mm_l1_right: mm_l1_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(TAB)>, <&kp LG(W)>;
        };

        mm_l2_up: mm_l2_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LC(UP_ARROW)>, <&kp F12>;
        };

        mm_l2_down: mm_l2_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(H)>, <&kp F16>;
        };  /* Shift=デスクトップ表示(仮:F11) */
        mm_l2_left: mm_l2_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp F15>, <&kp F20>;
        };  /* Shift=前のアプリ */
        mm_l2_right: mm_l2_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp F14>, <&kp F20>;
        };  /* Shift=次のアプリ */
        mm_l3_up: mm_l3_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp F3>, <&kp HOME>;
        };

        mm_l3_down: mm_l3_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(M)>, <&kp END>;
        };

        mm_l3_left: mm_l3_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(Q)>, <&mkp MB4>;
        };   /* Left: 通常=MB4 / Shift=左半分 */
        mm_l3_right: mm_l3_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(W)>, <&mkp MB5>;
        };   /* Right: 通常=MB5 / Shift=右半分 */
        mm_l7_up: mm_l7_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(T)>, <&kp LG(R)>;
        };  /* T Up: 通常=新規タブ / Shift=リロード */
        mm_l7_down: mm_l7_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(W)>, <&kp LG(F)>;
        };  /* T Down: 通常=タブ閉じる / Shift=検索 */
        mm_l7_left: mm_l7_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LC(LS(TAB))>, <&kp LG(LBKT)>;
        };  /* T Left: 通常=前タブ / Shift=戻る(⌘[) */
        mm_l7_right: mm_l7_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LC(TAB)>, <&kp LG(RBKT)>;
        };  /* T Right: 通常=次タブ / Shift=進む(⌘]) */
        mm_l11_up: mm_l11_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(C)>, <&kp LG(X)>;
        };

        mm_l11_down: mm_l11_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(V)>, <&kp LG(V)>;
        };

        mm_l11_left: mm_l11_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(Z)>, <&kp LG(P)>;
        };

        mm_l11_right: mm_l11_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(LS(Z))>, <&kp LG(RET)>;
        };

        mm_l12_up: mm_l12_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(A)>, <&kp LG(LS(UP_ARROW))>;
        };

        mm_l12_down: mm_l12_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(X)>, <&kp LG(LS(DOWN_ARROW))>;
        };

        mm_l12_left: mm_l12_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LA(LS(LEFT_ARROW))>, <&kp LG(LS(LEFT_ARROW))>;
        };

        mm_l12_right: mm_l12_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LA(LS(RIGHT_ARROW))>, <&kp LG(LS(RIGHT_ARROW))>;
        };

        mm_l13_up: mm_l13_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(LS(NUMBER_3))>, <&kp LC(LG(LS(NUMBER_3)))>;
        };

        mm_l13_down: mm_l13_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp ESC>, <&kp ESC>;
        };

        mm_l13_left: mm_l13_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(LS(NUMBER_4))>, <&kp LC(LG(LS(NUMBER_4)))>;
        };

        mm_l13_right: mm_l13_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LG(LS(NUMBER_5))>, <&kp LG(LS(NUMBER_5))>;
        };

        mm_l14_up: mm_l14_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp C_VOLUME_UP>, <&vol_max>;
        };

        mm_l14_down: mm_l14_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp C_VOLUME_DOWN>, <&kp C_MUTE>;
        };

        mm_l14_left: mm_l14_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp C_BRI_DN>, <&bri_min>;
        };

        mm_l14_right: mm_l14_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp C_BRI_UP>, <&bri_max>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &td_lt_w      &td_lt_e      &td_lt_r     &td_lt_t                                              &kp Y           &kp U     &lt 5 I    &kp O       &mt RIGHT_SHIFT P
&td_lt_a          &td_lt_s      &td_lt_d      &kp F        &lt 6 G   &kt LEFT_SHIFT      &mt LEFT_ALT AT_SIGN    &kp H           &kp J     &lt 5 K    &lt 4 L     &lt 2 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V        &kp B     &kp TAB             &mt LEFT_CONTROL COLON  &mt LEFT_GUI N  &td_lt_m  &kp COMMA  &kp PERIOD  &lt 3 PLUS
&kp LCTRL         &kp LEFT_GUI  &kp LEFT_ALT  &lt 3 SPACE  &mkp MB1  &lt 2 CAPS          &kp BACKSPACE           &lt 1 ENTER                                      &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        FUNCTION_GESTURE_A {
            bindings = <
&kp F5                &kp F4            &kp F3            &kp F2    &kp F1                                              &kp LS(RIGHT_ARROW)  &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &kp LC(TAB)
&kp F10               &kp F9            &kp F8            &kp F7    &kp F6   &kp ESC                &kp LS(LEFT_ARROW)  &kp LEFT_ARROW       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LS(LC(TAB))
&mt LEFT_SHIFT F11    &kp F17           &kp F16           &kp F15   &kp F14  &kp F13                &kp RG(A)           &kp RG(M)            &kp RG(Q)       &kp RG(W)       &kp RG(P)        &kp RS(RG(NUMBER_5))
&mt LEFT_CONTROL F12  &mt LEFT_GUI F19  &mt LEFT_ALT F18  &kp CAPS  &kp F20  &kp LG(BACKSPACE)      &kp BACKSPACE       &trans                                                                &kp RS(RG(NUMBER_4))
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        ARROW_SIGN_GESTURE_D {
            bindings = <
&kp LEFT_ARROW      &kp LEFT_ARROW       &kp UP_ARROW     &kp RIGHT_ARROW  &kp RIGHT_ARROW                                     &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &mt LEFT_SHIFT RIGHT_PARENTHESIS
&kp LEFT_ARROW      &kp LEFT_ARROW       &kp DOWN_ARROW   &kp RIGHT_ARROW  &kp HOME         &kp C_MUTE      &kp UNDERSCORE     &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&kp LS(LEFT_ARROW)  &kp LS(RIGHT_ARROW)  &kp LS(LC(TAB))  &kp LC(TAB)      &kp END          &kp ESC         &kp DOUBLE_QUOTES  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans              &trans               &trans           &to 0            &trans           &trans          &kp BACKSPACE      &kp ENTER                                                                  &kp PIPE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUM_GESTURE_W {
            bindings = <
&kp KP_NUMBER_5       &kp KP_NUMBER_4  &kp KP_NUMBER_3  &kp KP_NUMBER_2  &kp KP_NUMBER_1                               &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5
&kp KP_NUMBER_0       &kp KP_NUMBER_9  &kp KP_NUMBER_8  &kp KP_NUMBER_7  &kp KP_NUMBER_6  &kp CAPS      &kp EQUAL      &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0
&mt LEFT_SHIFT COMMA  &kp PERIOD       &kp SLASH        &kp ASTERISK     &kp MINUS        &kp PLUS      &kp PLUS       &kp MINUS        &kp ASTERISK     &kp SLASH        &kp PERIOD       &kp COMMA
&trans                &trans           &trans           &trans           &trans           &to 0         &kp BACKSPACE  &kp ENTER                                                           &kp RG(Z)
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        MOUSE {
            bindings = <
&mmv MOVE_LEFT       &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &kp LG(T)                                            &kp LG(Z)       &mkp MB5      &lt_mkp 5 MB4  &kp LG(A)  &kp LC(H)
&msc MOVE_RIGHT      &msc MOVE_DOWN  &msc MOVE_UP    &msc MOVE_LEFT   &mo 11     &mkp MB3             &safari_reload_once  &mkp MB3        &mkp MB2      &mkp MB1       &trans     &lt 5 ENTER
&mt LEFT_SHIFT HOME  &kp END         &kp DOWN_ARROW  &kp UP_ARROW     &mkp MB2   &mkp MB1             &kp LG(C)            &kp LG(V)       &kp UP_ARROW  &drag_off      &kp LG(X)  &lt 5 BACKSPACE
&kp LG(P)            &mkp MB5        &mkp MB4        &kp LEFT_ARROW   &kp TAB    &kp RIGHT_ARROW      &drag_on             &kp DOWN_ARROW                                          &trans
            >;

            sensor-bindings = <&rotate>;
        };

        SCROLL {
            bindings = <
&mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT   &trans                                      &kp LEFT_SHIFT  &kp RIGHT_ALT  &trans  &kp RIGHT_CONTROL  &trans
&msc MOVE_RIGHT  &msc MOVE_DOWN  &msc MOVE_UP  &msc MOVE_LEFT    &mo 12  &to 0                 &trans        &trans          &trans         &trans  &trans             &trans
&trans           &trans          &trans        &trans            &trans  &trans                &trans        &trans          &trans         &trans  &trans             &trans
&trans           &trans          &trans        &kp LG(NUMBER_9)  &trans  &kp LG(NUMBER_0)      &kp UP_ARROW  &kp DOWN_ARROW                                            &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(LA(MINUS)) LG(LA(PLUS))>;
        };

        Bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                              &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans           &trans             &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &kp LG(LA(ESC))  &kp LC(LG(Q))      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans           &trans             &trans          &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rotate>;
        };

        GESTURE_T {
            bindings = <
&trans                     &msc SCRL_UP  &msc SCRL_DOWN  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)                              &kp LG(R)       &kp PAGE_UP  &kp PAGE_DOWN  &trans  &trans
&lt_to_layer_0 5 KP_MINUS  &mkp MB1      &mkp MB1        &mkp MB2         &trans             &mkp MB3      &trans        &mkp MB3        &mkp MB2     &mkp MB1       &trans  &lt_to_layer_0 5 KP_MINUS
&kp HOME                   &kp END       &mkp MB4        &mkp MB5         &mkp MB5           &trans        &trans        &trans          &mkp MB4     &mkp MB5       &trans  &trans
&trans                     &trans        &trans          &to 0            &trans             &trans        &msc SCRL_UP  &msc SCRL_DOWN                                      &trans
            >;

            sensor-bindings = <&rotate>;
        };

        PS_PHOTO {
            bindings = <
&kp V      &kp M          &kp C          &kp J          &kp B                               &kp LG(NUMBER_0)  &kp LG(NUMBER_1)  &kp LG(L)  &kp LG(M)  &kp LG(U)
&kp LG(J)  &kp LG(LS(N))  &kp LG(E)      &kp LG(COMMA)  &kp LG(DOT)    &to 0       &kp ESC  &trans            &trans            &trans     &trans     &trans
&kp LG(Z)  &kp LG(LS(Z))  &kp LG(LA(Z))  &kp LG(LS(S))  &kp LG(LA(S))  &trans      &trans   &trans            &trans            &trans     &trans     &trans
&trans     &trans         &trans         &mo 9          &trans         &mo 10      &trans   &trans                                                    &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(MINUS) LG(PLUS)>;
        };

        PS_DRAW {
            bindings = <
&kp B   &kp E   &kp I   &kp X   &kp D                          &trans  &trans  &trans  &trans  &trans
&kp V   &kp M   &kp L   &kp J   &kp C   &kp LG(Z)      &trans  &trans  &trans  &trans  &trans  &trans
&kp Z   &kp A   &kp S   &kp F   &kp G   &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(MINUS) LG(PLUS)>;
        };

        PS_BRUSH {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &kp LG(Z)      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LBKT RBKT>;
        };

        GESTURE_E {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp F15 F14>;
        };

        GESTURE_R {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(MINUS) LG(PLUS)>;
        };

        GESTURE_S {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        GESTURE_M {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};

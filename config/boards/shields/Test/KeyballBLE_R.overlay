/* ===============================
 * KeyballBLE_R.overlay（全貼り替え）
 *  - tb_wheel_rema：スクロール端数繰り越し（常時）
 *  - zmk-mouse-gesture：ジェスチャ（ここで定義）
 *  - trackball_listener：入力プロセッサ接続（zip_temp_layer + tb_wheel_rema）
 * =============================== */

#include "KeyballBLE.dtsi"

#include <input/processors.dtsi>
#include <mouse-gesture.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/keys.h>   /* ★これが無いと LC()/LG() 等で落ちる */

/* col-offset は既存通り */
&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

/ {
    /* 端数繰り越し（ヌルヌル優先） */
    input_processors {
        tb_wheel_rema: tb_wheel_rema {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };

    /* トラックボール入力 → 一時レイヤーON + 端数繰り越し */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        input-processors = <
            &zip_temp_layer 13 200   /* ボールが動いたら 200ms だけレイヤー13 */
            &tb_wheel_rema  1 1      /* スクロール端数を貯める */
        >;
    };
};

/* ===============================
 * ジェスチャ定義（わかりやすい版）
 *  UP    : Mission Control (Ctrl + ↑)
 *  DOWN  : App Exposé     (Ctrl + ↓)
 *  LEFT  : 戻る          (Cmd + [)
 *  RIGHT : 進む          (Cmd + ])
 *
 * ※ まずは “単発4方向” だけにして安定させる
 * =============================== */
&zip_mouse_gesture {
    stroke-size = <150>;
    enable-eager-mode;
    idle-timeout-ms = <200>;

    mission_control {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(UP_ARROW)>;
    };

    app_expose {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LC(DOWN_ARROW)>;
    };

    back {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(LBKT)>;
    };

    forward {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(RBKT)>;
    };
};

/* ===============================
 * SPI / PMW3610
 * =============================== */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <
                NRF_PSEL(SPIM_SCK, 0, 5)
                NRF_PSEL(SPIM_MOSI, 0, 4)
                NRF_PSEL(SPIM_MISO, 0, 4)
            >;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <
                NRF_PSEL(SPIM_SCK, 0, 5)
                NRF_PSEL(SPIM_MOSI, 0, 4)
                NRF_PSEL(SPIM_MISO, 0, 4)
            >;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        scroll-layers = <5>;
    };
};

/* ===============================
 * KeyballBLE_R.overlay（全置き換え / 展開版）
 *  - tb_wheel_rema : 常時スクロール端数繰り越し
 *  - tb_drop_all   : ジェスチャ中は REL_X/Y/WHEEL/HWHEEL を 0倍（完全停止）
 *  - 各レイヤーで mouse-gesture を切替
 * =============================== */

#include "KeyballBLE.dtsi"

#include <input/processors.dtsi>
#include <mouse-gesture.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

&default_transform { col-offset = <6>; };

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9  GPIO_ACTIVE_HIGH>
        , <&xiao_d 8  GPIO_ACTIVE_HIGH>
        , <&xiao_d 7  GPIO_ACTIVE_HIGH>
        , <&gpio0 10  GPIO_ACTIVE_HIGH>
        ;
};

/ {
    /* ===============================
     * input processors
     * =============================== */
    input_processors {
        /* スクロール端数繰り越し（常時） */
        tb_wheel_rema: tb_wheel_rema {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };

        /* ★ジェスチャ中：カーソル＋スクロール完全停止（REL_* を 0倍） */
        tb_drop_all: tb_drop_all {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_X INPUT_REL_Y INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        };

        /* ===== A : アプリ操作 (layer 1) ===== */
        zip_mouse_gesture_l1: zip_mouse_gesture_l1 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;

            stroke-size = <70>;
            movement-threshold = <8>;
            idle-timeout-ms = <120>;
            gesture-cooldown-ms = <220>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp LG(N)>; };
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp LG(SPACE)>; };
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp LG(Q)>; };
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp LC(B)>; };
        };

        /* ===== D : デスクトップ (layer 2) ===== */
        zip_mouse_gesture_l2: zip_mouse_gesture_l2 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;

            stroke-size = <70>;
            movement-threshold = <8>;
            idle-timeout-ms = <120>;
            gesture-cooldown-ms = <220>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp LC(UP_ARROW)>; };
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp LG(H)>; };
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp F15>; };
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp F14>; };
        };

        /* ===== W : ウィンドウ (layer 3) ===== */
        zip_mouse_gesture_l3: zip_mouse_gesture_l3 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;

            stroke-size = <70>;
            movement-threshold = <8>;
            idle-timeout-ms = <120>;
            gesture-cooldown-ms = <220>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp F3>; };
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp LG(M)>; };
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp F2>; };
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp F1>; };
        };

        /* ===== B : ブラウザ (layer 6) ===== */
        zip_mouse_gesture_l6: zip_mouse_gesture_l6 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;

            stroke-size = <70>;
            movement-threshold = <8>;
            idle-timeout-ms = <120>;
            gesture-cooldown-ms = <220>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp LG(R)>; };   /* Reload */
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp LG(L)>; };   /* Address bar */
            left  { pattern = <GESTURE_LEFT>;  bindings = <&mkp MB4>; };    /* Back */
            right { pattern = <GESTURE_RIGHT>; bindings = <&mkp MB5>; };    /* Forward */
        };

        /* ===== T : タブ操作 (layer 7) ===== */
        zip_mouse_gesture_l7: zip_mouse_gesture_l7 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;

            stroke-size = <70>;
            movement-threshold = <8>;
            idle-timeout-ms = <120>;
            gesture-cooldown-ms = <180>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp LG(T)>;        }; /* 新規タブ */
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp LG(W)>;        }; /* タブを閉じる */
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp LC(LS(TAB))>;  }; /* 前のタブ */
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp LC(TAB)>;      }; /* 次のタブ */
        };

        /* ===== S : スクショ (layer 13) ===== */
        zip_mouse_gesture_l13: zip_mouse_gesture_l13 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;

            stroke-size = <70>;
            movement-threshold = <8>;
            idle-timeout-ms = <120>;
            gesture-cooldown-ms = <220>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp LG(LS(NUMBER_3))>; };
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp LG(LS(NUMBER_4))>; };
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp LG(LS(NUMBER_5))>; };
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp LG(LS(NUMBER_5))>; };
        };

        /* ===== M : メディア (layer 14) ===== */
        zip_mouse_gesture_l14: zip_mouse_gesture_l14 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;

            stroke-size = <70>;
            movement-threshold = <8>;
            idle-timeout-ms = <120>;
            gesture-cooldown-ms = <220>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp C_VOLUME_UP>; };
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp C_VOLUME_DOWN>; };
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp C_BRI_DN>; };
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp C_BRI_UP>; };
        };

        /* ===== C : カーソル (layer 15) ===== */
        zip_mouse_gesture_l15: zip_mouse_gesture_l15 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;

            stroke-size = <70>;
            movement-threshold = <8>;
            idle-timeout-ms = <120>;
            gesture-cooldown-ms = <180>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp UP_ARROW>;    };
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp DOWN_ARROW>;  };
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp LEFT_ARROW>;  };
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp RIGHT_ARROW>; };
        };

        /* ===== E : Edit (layer 16) ===== */
        zip_mouse_gesture_l16: zip_mouse_gesture_l16 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;

            stroke-size = <70>;
            movement-threshold = <8>;
            idle-timeout-ms = <120>;
            gesture-cooldown-ms = <220>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp LG(C)>; };         /* Copy */
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp LG(V)>; };         /* Paste */
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp LG(Z)>; };         /* Undo */
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp LG(LS(Z))>; };     /* Redo */
        };

        /* ===== R : Range (layer 17) ===== */
        zip_mouse_gesture_l17: zip_mouse_gesture_l17 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;

            stroke-size = <70>;
            movement-threshold = <8>;
            idle-timeout-ms = <120>;
            gesture-cooldown-ms = <220>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp LG(A)>; };          /* Select All */
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp ESC>; };            /* 選択解除 */
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp LA(LS(LEFT_ARROW))>; };   /* 単語選択← */
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp LA(LS(RIGHT_ARROW))>; };  /* 単語選択→ */
        };
    };

    /* ===============================
     * trackball listener
     * =============================== */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        /* デフォルト（常時）：端数繰り越しだけ */
        input-processors = <&tb_wheel_rema 1 1>;

        /*
         * 指定レイヤー時：
         *   gesture が先に REL_X/Y を見て判定
         *   その後 tb_drop_all が REL_* 出力を 0倍にして「完全停止」
         */
        gesture_l1  { layers = <1>;  input-processors = <&zip_mouse_gesture_l1  &tb_drop_all 0 1>; };
        gesture_l2  { layers = <2>;  input-processors = <&zip_mouse_gesture_l2  &tb_drop_all 0 1>; };
        gesture_l3  { layers = <3>;  input-processors = <&zip_mouse_gesture_l3  &tb_drop_all 0 1>; };
        gesture_l6  { layers = <6>;  input-processors = <&zip_mouse_gesture_l6  &tb_drop_all 0 1>; };
        gesture_l7  { layers = <7>;  input-processors = <&zip_mouse_gesture_l7  &tb_drop_all 0 1>; };
        gesture_l13 { layers = <13>; input-processors = <&zip_mouse_gesture_l13 &tb_drop_all 0 1>; };
        gesture_l14 { layers = <14>; input-processors = <&zip_mouse_gesture_l14 &tb_drop_all 0 1>; };
        gesture_l15 { layers = <15>; input-processors = <&zip_mouse_gesture_l15 &tb_drop_all 0 1>; };
        gesture_l16 { layers = <16>; input-processors = <&zip_mouse_gesture_l16 &tb_drop_all 0 1>; };
        gesture_l17 { layers = <17>; input-processors = <&zip_mouse_gesture_l17 &tb_drop_all 0 1>; };
    };

    /* 自動ON/OFF（入場でON / 退場でOFF） */
    layer_listeners {
        compatible = "zmk,layer-listeners";

        gesture_auto {
            layers = <1 2 3 6 7 13 14 15 16 17>;
            bindings = <&mouse_gesture_on &mouse_gesture_off>;
        };
    };
};

/* ===============================
 * PMW3610 SPI
 * =============================== */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)
                     NRF_PSEL(SPIM_MOSI, 0, 4)
                     NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)
                     NRF_PSEL(SPIM_MOSI, 0, 4)
                     NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        scroll-layers = <5>;
    };
};

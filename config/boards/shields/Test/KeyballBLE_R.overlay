#include "KeyballBLE.dtsi"

#include <input/processors.dtsi>
#include <mouse-gesture.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

&default_transform { col-offset = <6>; };

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9  GPIO_ACTIVE_HIGH>
        , <&xiao_d 8  GPIO_ACTIVE_HIGH>
        , <&xiao_d 7  GPIO_ACTIVE_HIGH>
        , <&gpio0 10  GPIO_ACTIVE_HIGH>
        ;
};

/ {
    /* ===============================
     * input processors
     * =============================== */
    input_processors {
        /* スクロール端数繰り越し（常時） */
        tb_wheel_rema: tb_wheel_rema {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };

        /* ===== A : アプリ操作 (layer 1) ===== */
        zip_mouse_gesture_l1: zip_mouse_gesture_l1 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;
            stroke-size = <60>;
            idle-timeout-ms = <350>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp LC(SPACE)>; };
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp LC(TAB)>;   };
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp LC(N)>;     };
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp LC(Q)>;     };
        };

        /* ===== D : デスクトップ (layer 2) ===== */
        zip_mouse_gesture_l2: zip_mouse_gesture_l2 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;
            stroke-size = <60>;
            idle-timeout-ms = <350>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp LC(UP_ARROW)>; };
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp LC(DOWN_ARROW)>; };
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp F15>; };
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp F14>; };
        };

        /* ===== W : ウィンドウ (layer 3) ===== */
        zip_mouse_gesture_l3: zip_mouse_gesture_l3 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;
            stroke-size = <60>;
            idle-timeout-ms = <350>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp F3>; };
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp LC(DOWN_ARROW)>; };
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp MB4>; };
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp MB5>; };
        };

        /* ===== B : ブラウザ (layer 6) ===== */
        zip_mouse_gesture_l6: zip_mouse_gesture_l6 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;
            stroke-size = <60>;
            idle-timeout-ms = <350>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp LC(T)>; };
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp LC(W)>; };
            left  { pattern = <GESTURE_LEFT>;  bindings = <&mkp MB4>; };
            right { pattern = <GESTURE_RIGHT>; bindings = <&mkp MB5>; };
        };

        /* ===== S : スクショ (layer 13) ===== */
        zip_mouse_gesture_l13: zip_mouse_gesture_l13 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;
            stroke-size = <60>;
            idle-timeout-ms = <350>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp LC(LS(NUMBER_3))>; };
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp LC(LS(NUMBER_4))>; };
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp LC(LS(NUMBER_5))>; };
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp LC(LS(NUMBER_5))>; };
        };

        /* ===== M : メディア (layer 14) ===== */
        zip_mouse_gesture_l14: zip_mouse_gesture_l14 {
            compatible = "zmk,input-processor-mouse-gesture";
            #input-processor-cells = <0>;
            stroke-size = <60>;
            idle-timeout-ms = <350>;
            enable-eager-mode;

            up    { pattern = <GESTURE_UP>;    bindings = <&kp C_VOLUME_UP>; };
            down  { pattern = <GESTURE_DOWN>;  bindings = <&kp C_VOLUME_DOWN>; };
            left  { pattern = <GESTURE_LEFT>;  bindings = <&kp C_BRI_DN>; };
            right { pattern = <GESTURE_RIGHT>; bindings = <&kp C_BRI_UP>; };
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        input-processors = <&tb_wheel_rema 1 1>;

        gesture_l1  { layers = <1>;  input-processors = <&zip_mouse_gesture_l1  &tb_wheel_rema 1 1>; };
        gesture_l2  { layers = <2>;  input-processors = <&zip_mouse_gesture_l2  &tb_wheel_rema 1 1>; };
        gesture_l3  { layers = <3>;  input-processors = <&zip_mouse_gesture_l3  &tb_wheel_rema 1 1>; };
        gesture_l6  { layers = <6>;  input-processors = <&zip_mouse_gesture_l6  &tb_wheel_rema 1 1>; };
        gesture_l13 { layers = <13>; input-processors = <&zip_mouse_gesture_l13 &tb_wheel_rema 1 1>; };
        gesture_l14 { layers = <14>; input-processors = <&zip_mouse_gesture_l14 &tb_wheel_rema 1 1>; };
    };

    layer_listeners {
        compatible = "zmk,layer-listeners";

        gesture_auto {
            layers = <1 2 3 6 13 14>;
            bindings = <&mouse_gesture_on &mouse_gesture_off>;
        };
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            /* ★ここ：カンマ無しで並べる */
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)
                     NRF_PSEL(SPIM_MOSI, 0, 4)
                     NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)
                     NRF_PSEL(SPIM_MOSI, 0, 4)
                     NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        scroll-layers = <5>;
    };
};
